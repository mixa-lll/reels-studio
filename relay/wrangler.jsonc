{
  // Relay between reels.mygudauri.org and the web studio on Misha's Mac (see worker.js).
  "name": "reels-relay",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "routes": [{"pattern": "reels.mygudauri.org/*", "zone_name": "mygudauri.org"}],
  "durable_objects": {"bindings": [{"name": "RELAY", "class_name": "Relay"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Relay"]}],
  "observability": {"enabled": true}
}
