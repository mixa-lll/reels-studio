# Written by the installing agent; owners change settings by talking to the bot (projects/<slug>/settings.json, data/settings.json).

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Only whoever opens t.me/<bot>?start=<code> becomes the owner.
# Empty: the owner is confirmed on this computer instead (node bot/claim.mjs).
OWNER_CODE=

# Which coding agent drives the bot: claude | codex.
AGENT=claude
# Full path to its CLI if it is not on PATH for the service.
AGENT_BIN=
# Optional model override, e.g. opus or gpt-5.
AGENT_MODEL=

# Language of the bot's own short messages: ru | en.
BOT_LANG=ru
# The agent session is rotated (after a handoff note) when any limit is hit.
SESSION_MAX_TOKENS=120000
SESSION_MAX_TURNS=40
SESSION_IDLE_HOURS=12

# Local speech-to-text model for voice notes: tiny | base | small | medium.
STT_MODEL=small

# HTTPS address of the studio's mini app (…/app), e.g. through a Cloudflare tunnel.
# Set it and the bot gets /app and a «Съёмка» button next to the message field.
MINIAPP_URL=
# Only where the studio runs without the bot (the shared stage): Telegram user ids
# treated as the owner in the mini app, comma-separated; the first gets notifications.
MINIAPP_OWNERS=
# Telegram ids that work in the bot as editors without an invite (partners on the
# shared stage), comma-separated. The ids in MINIAPP_OWNERS count too.
BOT_EDITORS=

# Cloudflare R2 for old copies (bot/cloud.mjs): the studio's bin goes there and is kept 30 days,
# packed reels (published 14+ days ago) send their media and sources there for good.
# An R2 API token with Object Read & Write on this bucket. Empty: the bin stays on this disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
