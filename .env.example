# Written by the installing agent; owners change settings by talking to the bot (studio/settings.json).

# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Which coding agent drives the bot: claude | codex.
AGENT=claude
# Full path to its CLI if it is not on PATH for the service.
AGENT_BIN=
# Optional model override, e.g. opus or gpt-5.
AGENT_MODEL=

# Language of the bot's own short messages: ru | en.
BOT_LANG=ru
# The agent session is rotated (after a handoff note) when any limit is hit.
SESSION_MAX_TOKENS=120000
SESSION_MAX_TURNS=40
SESSION_IDLE_HOURS=12

# Local speech-to-text model for voice notes: tiny | base | small | medium.
STT_MODEL=small
